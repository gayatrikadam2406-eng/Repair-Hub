# Server and MySQL settings
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=repair_hub
DB_PORT=3306
JWT_SECRET=replace_with_a_long_random_secret

# Admin and technician accounts
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

TECHNICIAN_NAME=Technician
TECHNICIAN_EMAIL=technician@example.com
TECHNICIAN_PASSWORD=your_technician_password

# Gmail SMTP settings; use a Google App Password, not your normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_google_app_password
EMAIL_FROM=Repair Hub <your_email@gmail.com>
